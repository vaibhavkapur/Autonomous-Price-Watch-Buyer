# Copy to .env (docker compose) or export in your shell.
APP_PROFILE=development            # demo controls are disabled unless APP_PROFILE=development
DEMO_CONTROLS=true
DATABASE_URL=sqlite:///data/pricewatch.sqlite3
# DATABASE_URL=postgresql+psycopg://pricewatch:pricewatch@localhost:5432/pricewatch
DEV_KEYS_PATH=fixtures/authorizations/dev_keys.json   # generated on first run; DEVELOPMENT KEYS ONLY
ARTIFACT_ENCRYPTION_KEY=dev-only-change-me
MERCHANT_A_URL=http://localhost:8101
MERCHANT_B_URL=http://localhost:8102
POLL_INTERVAL_SECONDS=60
POLL_JITTER_SECONDS=10
LEASE_SECONDS=120
OBSERVATION_FRESHNESS_SECONDS=300
MERCHANT_MIN_INTERVAL_MS=500
MERCHANT_BACKOFF_BASE_SECONDS=30
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Host-port remaps when the defaults are already taken:
# POSTGRES_PORT=5433
# API_PORT=8002
# WEB_PORT=3001
# MERCHANT_A_PORT=8101
# MERCHANT_B_PORT=8103
# PUBLIC_API_URL=http://localhost:8002
